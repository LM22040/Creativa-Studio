# ============================================
# CREATIVA ESTUDIOS - Variables de entorno
# Configuración con SQLite (Base de datos local)
# ============================================

# Puerto del servidor
PORT=3000

# Secreto para JWT (cámbialo por algo seguro en producción)
JWT_SECRET=creativa_secreto_muy_seguro_2024

# Tiempo de expiración del token (ej: 8h, 1d, 24h)
JWT_EXPIRES_IN=24h

# ============================================
# NOTAS:
# ============================================
# - SQLite no requiere configuración de conexión adicional
# - La base de datos se crea automáticamente en: backend/creativa_estudios.db
# - Para producción, considera usar PostgreSQL o MySQL
# - Cambia JWT_SECRET antes de desplegar en producción
