# ============================================
# CREATIVA ESTUDIOS - Variables de entorno
# Copia este archivo como .env y completa tus datos
# ============================================

# Puerto del servidor
PORT=4000

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=creativa_estudios
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui

# Secreto para JWT (cámbialo por algo seguro)
JWT_SECRET=creativa_secreto_muy_seguro_2024

# Tiempo de expiración del token (ej: 8h, 1d)
JWT_EXPIRES_IN=8h
